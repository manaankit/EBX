# Instagram Reel Generator Environment Variables

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Crown Carnival Settings
CROWN_CARNIVAL_URL=https://crowncarnival.shop
REQUEST_DELAY=1
MAX_RETRIES=3
TIMEOUT=30

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION=15

# Output Settings
OUTPUT_DIR=generated_reels
TEMP_DIR=temp

# Instagram Settings
MAX_HASHTAGS=30
MAX_CAPTION_LENGTH=2200

# Debug Settings
DEBUG=false
LOG_LEVEL=INFO

# Optional: Custom Font Paths
# FONT_PATH_REGULAR=/path/to/font-regular.ttf
# FONT_PATH_BOLD=/path/to/font-bold.ttf

# Optional: Custom Logo/Watermark
# LOGO_PATH=/path/to/logo.png
# WATERMARK_OPACITY=0.7

# Optional: Background Music
# DEFAULT_MUSIC_PATH=/path/to/background-music.mp3
# MUSIC_VOLUME=0.3

